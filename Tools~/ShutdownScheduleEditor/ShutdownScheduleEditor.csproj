<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wonjeong.Tools.ShutdownScheduleEditor</RootNamespace>
    <AssemblyName>ShutdownScheduleEditor</AssemblyName>
    <!-- 고해상도 모니터에서 흐릿하게 확대되지 않도록 DPI를 직접 처리함. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- self-contained 단일 파일 게시 시 .NET Desktop 런타임의 네이티브 DLL까지 exe 안에
         묶어, 옆에 딸린 DLL 없이 exe 하나만 배포할 수 있게 함. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- schtasks.exe 출력을 OS의 OEM 코드페이지(한글 Windows는 949)로 읽기 위해 필요함.
         .NET 8은 UTF-8/UTF-16/UTF-32/ASCII/Latin1 외의 코드페이지를 기본 내장하지 않음. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
